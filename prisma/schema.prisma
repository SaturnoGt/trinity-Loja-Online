generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  price       Float
  description String?
  category    String?
  createdAt   DateTime    @default(now())
  height      Float?
  length      Float?
  weight      Float?
  width       Float?
  favorites   Favorite[]
  images      Image[]
  orderItems  OrderItem[]
  variations  Variation[]
}

model Image {
  id        Int     @id @default(autoincrement())
  imageUrl  String
  isMain    Boolean @default(false)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Variation {
  id         Int         @id @default(autoincrement())
  size       String
  color      String
  stock      Int
  productId  Int
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  password     String
  role         String     @default("CLIENTE")
  isVerified   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  avatarUrl    String?
  birthDate    DateTime?
  city         String?
  complement   String?
  cpf          String?    @unique
  name         String?
  neighborhood String?
  number       String?
  phone        String?
  state        String?
  street       String?
  zipCode      String?
  favorites    Favorite[]
  orders       Order[]
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Order {
  id                   String      @id @default(uuid())
  status               OrderStatus @default(PENDING)
  total                Float
  paymentId            String?     @unique
  userId               String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  stockReducedAt       DateTime?
  preferenceId         String?
  shippingCity         String?
  shippingCompany      String?
  shippingComplement   String?
  shippingDeadline     Int?
  shippingLabelUrl     String?
  shippingName         String?
  shippingNeighborhood String?
  shippingNumber       String?
  shippingPhone        String?
  shippingPrice        Float?
  shippingService      String?
  shippingServiceId    String?
  shippingState        String?
  shippingStreet       String?
  shippingZipCode      String?
  subtotal             Float?
  trackingCode         String?
  trackingUrl          String?
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([preferenceId])
  @@index([trackingCode])
}

model OrderItem {
  id          String     @id @default(uuid())
  productId   Int
  productName String
  quantity    Int
  unitPrice   Float
  orderId     String
  color       String?
  size        String?
  variationId Int?
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product    @relation(fields: [productId], references: [id])
  variation   Variation? @relation(fields: [variationId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variationId])
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model MelhorEnvioCredential {
  id                    String    @id @default("main")
  accessToken           String
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  PROCESSING
  SHIPPED
  DELIVERED
}
